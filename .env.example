# Copy this file to .env and fill in your real key. .env is already gitignored.

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
COURSE_DB_PATH=course_offerings.db
# DLSU term the scheduler/agent query. course_offerings holds several terms;
# queries are scoped to exactly one so archived data (e.g. 1241) is never mixed
# into a live schedule. Defaults to the incoming term (1261).
SCHEDULE_TERM=1261
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sql_agent
